{
  "name": "quality-reference-application",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "description": "A small synthetic policy and claims reference application for independent QA framework exercises.",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "10.9.4"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "check:runtime": "node scripts/check-runtime.js",
    "start": "node src/server.js",
    "test:unit": "node tests/domain.test.js && npm run test:security-disposition",
    "test:security-disposition": "node tests/security-disposition.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "test": "npm run check:runtime && npm run test:unit && npm run test:integration",
    "db:migrate": "node scripts/migrate.js",
    "check:openapi": "node scripts/check-openapi.js",
    "test:openapi": "node --test tests/openapi-check.test.js",
    "verify": "npm run check:runtime && npm run test:openapi && npm run check:openapi && npm test"
  },
  "dependencies": {
    "pg": "8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "2.64.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
